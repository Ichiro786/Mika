<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 http:用户自己在本机或局域网跑的模型服务(如 http://192.168.1.10:11434/v1)多半只有 http。
  内置浏览器因此也能直接打开 http 网页(不再先被系统拒绝、再换 https 重试)。
  添加服务商时,不加密又不在本机、局域网的地址会提示一句(见 LocalHosts)。
  全局只信系统 CA:官方云服务商、GitHub、内置浏览器等流量不接受用户安装的 CA(ORB-047)。
  企业内网自建的模型服务(GPUStack/vLLM 一类)常由公司内部 CA 签发证书(#361):
  只有连自定义、自建服务商和 MCP 服务的 OkHttp 客户端额外信任用户 CA,见 settings/UserCaTrust.kt。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
