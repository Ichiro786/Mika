<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mika" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/orbit_splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/orbit_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/orbit_splash_icon</item>
