    <string name="whatsapp_how">工作方式</string>
    <string name="whatsapp_how_body">给自己发送一条以“Orbit”开头的 WhatsApp 消息，例如“Orbit，订两人座位，晚上 8 点”。Orbit 会在这部手机上完成任务，并在同一聊天中回复。</string>
    <string name="whatsapp_risk_title">关联前请注意</string>
    <string name="whatsapp_risk_body">Orbit 使用非官方的 WhatsApp 客户端（whatsmeow）以设备身份关联。WhatsApp 不允许非官方客户端，因此你的号码可能会被封禁。Orbit 只会读取和发送你选择的聊天，并且在每条消息发出前都会先在这部手机上征得你的同意。</string>
    <string name="whatsapp_phone_label">你的 WhatsApp 号码（含国家或地区代码）</string>
    <string name="whatsapp_get_code">获取关联码</string>
    <string name="whatsapp_use_qr">改为显示二维码</string>
    <string name="whatsapp_code_title">在 WhatsApp 中输入此码</string>
    <string name="whatsapp_code_help">在 WhatsApp 中打开“设置 › 关联设备 › 关联设备”，点按“改用手机号码关联”，然后输入此码。WhatsApp 也可能弹出通知要求输入。</string>
    <string name="whatsapp_qr_help">在已登录 WhatsApp 的手机上打开“设置 › 关联设备 › 关联设备”，然后扫描此码。</string>
    <string name="whatsapp_link_failed">无法开始关联。请检查号码和网络连接后重试。</string>
    <string name="whatsapp_chats">Orbit 可以使用的聊天</string>
    <string name="whatsapp_chats_none">暂无。在你选择聊天之前，Orbit 无法读取或发送任何聊天消息。</string>
    <string name="whatsapp_chats_pick">选择聊天</string>
    <string name="whatsapp_chats_search">搜索聊天</string>
